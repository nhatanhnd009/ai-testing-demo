{
  "name": "testing",
  "version": "1.0.0",
  "private": true,
  "description": "AI-assisted tester demo using Playwright Page Object Model",
  "scripts": {
    "check:config": "node scripts/check-config.mjs",
    "check:skills": "node scripts/validate-skills.mjs",
    "check:mapping": "node scripts/validate-automation-mapping.mjs",
    "test:unit": "node --test scripts/check-config.test.mjs scripts/automation-mapping.test.mjs scripts/summarize-results.test.mjs scripts/run-by-id.test.mjs scripts/publish-report-pages.test.mjs && node --import tsx --test tests/config/environment.test.ts",
    "typecheck": "tsc --noEmit",
    "test:list": "playwright test --list --pass-with-no-tests",
    "test": "playwright test",
    "test:api": "playwright test tests/api --pass-with-no-tests",
    "test:ui": "playwright test tests/ui --pass-with-no-tests",
    "test:integration": "playwright test tests/integration --pass-with-no-tests",
    "test:e2e": "playwright test tests/end-to-end --pass-with-no-tests",
    "test:id": "node scripts/run-by-id.mjs",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report reports/playwright-report",
    "report:publish": "npm run summarize && node scripts/publish-report-pages.mjs",
    "report:publish:dry": "npm run summarize && node scripts/publish-report-pages.mjs --dry-run",
    "summarize": "node scripts/summarize-results.mjs",
    "verify": "npm run check:config && npm run check:skills && npm run check:mapping && npm run test:unit && npm run typecheck && npm run test:list"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
